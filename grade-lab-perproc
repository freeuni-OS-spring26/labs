@test(5, "count copyin")
def test_count():
    # Run `stats` twice and check that each `stats` invocation drives a
    # fixed number of copyin()/copyinstr() calls -- i.e. that copyin and
    # copyinstr have been rerouted through copyin_new/copyinstr_new (which
    # bump the counters).  The per-invocation deltas are deterministic;
    # copyin is 27 under the grade harness (28 when typed by hand), and
    # copyinstr is 3.
    r.run_qemu(shell_script([
        'stats', 'stats'
    ]), timeout=150)
    matches = re.findall(r'^copyin: (\d+)', r.qemu.output, re.MULTILINE)
    assert_equal(len(matches), 2)
    d = int(matches[1]) - int(matches[0])
    if d not in (27, 28):
        raise AssertionError(
            "copyin count increased by %d between runs, expected ~28 "
            "(did you reroute copyin to copyin_new?)" % d)
    matches = re.findall(r'^copyinstr: (\d+)', r.qemu.output, re.MULTILINE)
    assert_equal(len(matches), 2)
    assert_equal(int(matches[1]), int(matches[0]) + 3)


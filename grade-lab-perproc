@test(0, "pte printout")
def test_pteprint():
    r.run_qemu(shell_script([
        'echo hi'
    ]))
    r.match('^hi')
    r.match(
        '^page table 0x',
        '^ \.\.0x0000000000000000',
        '^ \.\. \.\.0x0000000000000000',
        '^ \.\. \.\. \.\.0x0000000000000000',
        '^ \.\. \.\. \.\.0x0000000000001000',
        '^ \.\. \.\. \.\.0x0000000000002000',
        '^ \.\. \.\. \.\.0x0000000000003000',
        '^ \.\.(0xffffffffc0000000|0x0000003fc0000000)',
        '^ \.\. \.\.(0xffffffffffe00000|0x0000003fffe00000)',
        '^ \.\. \.\. \.\.(0xffffffffffffe000|0x0000003fffffe000)',
        '^ \.\. \.\. \.\.(0xfffffffffffff000|0x0000003ffffff000)',
    )

